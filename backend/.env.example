# ==============================================================================
# MediVault - Variables de Entorno de Ejemplo (Sin Credenciales Reales)
# FWD Costa Rica - Proyecto Final Full Stack
# ==============================================================================

# Configuración del Servidor y Entorno
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Criptografía y Seguridad (AES-256-GCM clave en Base64 de 32 bytes)
# Generar nueva clave con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=INSERTE_AQUI_CLAVE_BASE64_DE_32_BYTES_==

# Autenticación JWT
JWT_SECRET=inserte_aqui_clave_secreta_jwt_robusta_para_produccion
JWT_EXPIRES_IN=1h

# Políticas de Protección Anti-Fuerza Bruta
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# APIs Externas Costarricenses e Indicadores
BCCR_TOKEN=token_suministrado_por_banco_central_de_costa_rica
HACIENDA_API_URL=https://api.hacienda.go.cr/fe
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
