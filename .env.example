# ==============================================================================
# MediVault - Variables de Entorno de Ejemplo (OWASP Top 10:2025 Compliant)
# Bóveda Médica y Expediente Clínico Seguro
# ==============================================================================

# Runtime y Servidor
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://medivault-production.onrender.com

# Criptografía AES-256-GCM (Clave simétrica de 32 bytes en Base64)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=WjV4ODNrc3lMbmE5M1pRYWJDZEdISktMTU5PUFFSU1Q=

# Soporte de rotación de claves en caliente (Key Version 2)
DATA_ENCRYPTION_KEY_V2=

# Autenticación JWT y Firma de Integridad HMAC
JWT_SECRET=inserte_aqui_clave_secreta_jwt_de_alta_entropia_para_produccion_medivault_2026_@#!
JWT_EXPIRES_IN=1h

# Mitigación Anti-Fuerza Bruta (OWASP A07)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# APIs Externas (Lista Blanca - Anti-SSRF OWASP A01)
BCCR_TOKEN=demo_bccr_token
HACIENDA_API_URL=https://api.hacienda.go.cr/fe
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
