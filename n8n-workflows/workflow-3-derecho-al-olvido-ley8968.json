{
  "name": "MediVault - Gestión y Anonimización Derecho al Olvido (Ley N.° 8968)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "medivault-derecho-olvido",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-deletion",
      "name": "Webhook: Solicitud de Supresión ARCO",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.userId }}",
              "operation": "isNotEmpty"
            },
            {
              "value1": "={{ $json.body.confirmationToken }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "node-verify-identity",
      "name": "Verificar Identidad y Token",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5000/api/governance/process-deletion",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Internal-Secret",
              "value": "n8n-internal-automation-key"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"userId\": {{ $json.body.userId }},\n  \"reason\": \"{{ $json.body.reason || 'Ejercicio Derecho al Olvido Art. 7 Ley 8968' }}\",\n  \"action\": \"anonymize_and_purge\"\n}",
        "options": {}
      },
      "id": "node-execute-anonymization",
      "name": "Ejecutar Anonimización en BD",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 200]
    },
    {
      "parameters": {
        "fromEmail": "privacidad@medivault.cr",
        "toEmail": "={{ $json.body.userEmail }}",
        "subject": "Confirmación Legal: Supresión de Datos Personales MediVault (Ley N.° 8968)",
        "text": "=Estimado(a) usuario(a),\n\nLe confirmamos que su solicitud para el ejercicio del Derecho de Supresión (Derecho al Olvido), al amparo del Artículo 7 de la Ley N.° 8968 de Costa Rica, ha sido ejecutada con éxito.\n\nSus datos personales de perfil y notas privadas han sido anonimizados o eliminados de forma irrevocable en nuestras bases de datos principales.\n\nNúmero de expediente legal: ARCO-{{ $now.toFormat('yyyyMMdd-HHmmss') }}\n\nAtentamente,\nOficialía de Protección de Datos Personales\nMediVault Soluciones Clínicas S.A.",
        "options": {}
      },
      "id": "node-send-arco-confirmation",
      "name": "Enviar Certificado de Supresión ARCO",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"completed\",\n  \"message\": \"Proceso de supresión y anonimización completado conforme a la Ley N.° 8968\",\n  \"legalNotice\": \"Los registros fiscales históricos se conservan por 5 años conforme al Código de Normas y Procedimientos Tributarios de Costa Rica.\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-deletion-ok",
      "name": "Responder 200 OK a Solicitud",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"rejected\",\n  \"error\": \"Token de confirmación o identidad de usuario inválida. La solicitud no pudo ser procesada.\"\n}",
        "options": {
          "responseCode": 403
        }
      },
      "id": "node-respond-unauthorized",
      "name": "Responder 403 Rechazado",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 420]
    }
  ],
  "connections": {
    "Webhook: Solicitud de Supresión ARCO": {
