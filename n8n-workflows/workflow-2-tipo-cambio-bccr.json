{
  "name": "MediVault - Sincronización Diaria Tipo de Cambio BCCR",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * 1-5"
            }
          ]
        }
      },
      "id": "node-schedule-trigger",
      "name": "Cron Diario (6:00 AM L-V)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:5000/api/external/exchange-rate",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node-fetch-bccr",
      "name": "Consultar API BCCR MediVault",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.compra }}",
              "operation": "larger",
              "value2": 400
            },
            {
              "value1": "={{ $json.venta }}",
              "operation": "larger",
              "value2": 400
            }
          ]
        }
      },
      "id": "node-validate-rates",
      "name": "Validar Rango Razonable Tipo Cambio",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5000/api/admin/audit-log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"eventType\": \"BCCR_EXCHANGE_RATE_SYNC\",\n  \"details\": \"Tipo de cambio BCCR actualizado exitosamente: Compra ₡{{ $json.compra }} / Venta ₡{{ $json.venta }}\",\n  \"source\": \"n8n_automation_worker\",\n  \"fecha\": \"{{ $json.fecha }}\"\n}",
        "options": {}
      },
      "id": "node-save-log",
      "name": "Registrar en Auditoría MediVault",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "fromEmail": "finanzas@medivault.cr",
        "toEmail": "admin@medivault.cr",
        "subject": "=Actualización Diaria BCCR: Compra ₡{{ $json.compra }} | Venta ₡{{ $json.venta }}",
        "text": "=Reporte Automático de Indicadores Económicos BCCR para Facturación Médica MediVault:\n\nFecha: {{ $json.fecha }}\nIndicador Compra (317): ₡{{ $json.compra }}\nIndicador Venta (318): ₡{{ $json.venta }}\n\nLas tarifas de consulta y tratamientos en dólares han sido sincronizadas conforme a los valores oficiales del Banco Central de Costa Rica.",
        "options": {}
      },
      "id": "node-notify-admin",
      "name": "Notificar a Administración y Contabilidad",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "fromEmail": "alertas@medivault.cr",
        "toEmail": "soporte@medivault.cr",
        "subject": "⚠️ Alerta n8n: Falla en Sincronización BCCR",
        "text": "No se pudo obtener un valor de tipo de cambio válido del BCCR o el valor se encuentra fuera de rangos nominales. Por favor verificar conectividad y tokens del Banco Central.",
        "options": {}
      },
      "id": "node-notify-error",
      "name": "Alerta de Incidencia BCCR",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Cron Diario (6:00 AM L-V)": {
      "main": [
        [
          {
            "node": "Consultar API BCCR MediVault",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Consultar API BCCR MediVault": {
      "main": [
        [
          {
            "node": "Validar Rango Razonable Tipo Cambio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validar Rango Razonable Tipo Cambio": {
      "main": [
        [
          {
            "node": "Registrar en Auditoría MediVault",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alerta de Incidencia BCCR",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Registrar en Auditoría MediVault": {
      "main": [
        [
          {
            "node": "Notificar a Administración y Contabilidad",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}